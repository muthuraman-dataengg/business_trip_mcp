# ---------------------------------------------------------------- LLM
# Any LangChain init_chat_model id: openai:gpt-5.6, anthropic:claude-sonnet-5-5, google_genai:gemini-..., groq:...
LLM_MODEL=openai:gpt-5.6
LLM_REASONING_EFFORT=none
OPENAI_API_KEY=sk-...your-key...
# ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------- MCP transport
# stdio     : the host launches the servers as subprocesses (default, zero setup)
# http      : connect to servers started with `python scripts/start_servers.py` or docker compose
# inprocess : servers run inside the host's Python process (fastest for local UI / notebooks)
MCP_TRANSPORT=stdio
TRAVEL_MCP_URL=http://127.0.0.1:8001/mcp
POLICY_MCP_URL=http://127.0.0.1:8002/mcp
WORK_MCP_URL=http://127.0.0.1:8003/mcp
TRAVEL_MCP_PORT=8001
POLICY_MCP_PORT=8002
WORK_MCP_PORT=8003
# Shared secret for HTTP servers (clients send "Authorization: Bearer <key>"). Leave empty to disable.
MCP_API_KEY=
# Comma separated Host headers accepted by HTTP servers (DNS-rebinding protection), e.g. travel:8001,localhost:8001
MCP_ALLOWED_HOSTS=

# ---------------------------------------------------------------- Data
# DATA_DIR=./data
# DATABASE_PATH=./data/copilot.db

# ---------------------------------------------------------------- Providers (optional)
# Live flight offers. Get a free test token (duffel_test_...) at https://app.duffel.com
DUFFEL_ACCESS_TOKEN=
HTTP_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
